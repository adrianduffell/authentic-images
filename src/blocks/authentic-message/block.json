{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "authenticimages/authentic-message",
	"title": "Authentic Message",
	"category": "woocommerce",
	"description": "Displays a message on product pages.",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true
		}
	},
	"attributes": {
		"fontSize": {
			"type": "string",
			"default": "small"
		}
	},
	"textdomain": "authenticimages"
}
